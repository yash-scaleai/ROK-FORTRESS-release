# Pick ONE of the two modes below. Mode A is the simpler direct-provider path;
# Mode B reproduces the paper's exact routing through a LiteLLM proxy.
# See README.md § "API setup" for the full walk-through.

# ─── Mode A: direct provider keys (no proxy, recommended) ───────────────────
# litellm dispatches by the provider/ prefix in each model name. Fill in
# whichever providers you actually need for the model panel you'll evaluate.
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
GEMINI_API_KEY=your_gemini_key
FIREWORKS_AI_API_KEY=your_fireworks_key
# Bedrock (Mistral Large 3, Qwen3) -- standard AWS env vars:
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION_NAME=us-west-2

# ─── Mode B: route everything through a LiteLLM proxy ───────────────────────
# Set BASE_URL (or OPENAI_BASE_URL) to a running proxy and the codebase will
# send all calls there with provider-prefixed model names. Sample proxy config:
# configs/litellm-proxy.example.yaml.
# BASE_URL=http://localhost:4000/v1
# API_KEY=sk-anything-the-proxy-accepts

# ─── Optional: local vLLM judge (HyperCLOVA X) ─────────────────────────────
# VLLM_JUDGE_BASE_URL=http://localhost:8000/v1
